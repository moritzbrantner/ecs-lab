{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "build", "test"],
    "standard": ["format:check", "lint", "build", "test", "test:integration"],
    "performance": ["benchmark:smoke"]
  },
  "requiredCapabilities": ["format:check", "lint", "build", "test"],
  "optionalCapabilities": ["test:integration"],
  "capabilityCommands": {
    ".": {
      "benchmark": ["bash", "scripts/benchmark.sh", "full"],
      "benchmark:smoke": ["bash", "scripts/benchmark.sh", "smoke"]
    }
  },
  "merge": {
    "authority": "hosted",
    "requiredChecks": ["validate"]
  }
}
