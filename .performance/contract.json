    },
    {
      "id": "material-step-sparse",
      "kind": "scaling",
      "description": "Sparse 96-body material step isolates candidate traversal and must not produce exact contacts.",
      "dimensions": {
        "bodies": 96,
        "spacing": 8,
        "frames": 1,
        "repetitions": 3
      },
      "correctnessEvidence": [
        "physics step succeeds",
        "zero exact contacts in preflight"
      ],
      "metrics": [
        {
          "name": "contacts",
          "unit": "contacts",
          "direction": "lower",
          "signal": "operation-count",
          "blocking": true,
          "budget": {
            "max": 0
          }
        },
        {
          "name": "candidate_pairs",
          "unit": "pairs",
          "direction": "lower",
          "signal": "operation-count",
          "blocking": true,
          "budget": {
            "relativeRegressionPercent": 10
          }
        },
        {
          "name": "elapsed_ns",
          "unit": "ns",
          "direction": "lower",
          "signal": "wall-clock",
          "blocking": false
        }
      ]
    },
